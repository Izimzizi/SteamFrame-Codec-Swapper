<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/BitratePatcher.cs" Link="BitratePatcher.cs" />
    <Compile Include="../../Core/DriverCompatibility.cs" Link="DriverCompatibility.cs" />
    <Compile Include="../../Core/RuntimeProcessState.cs" Link="RuntimeProcessState.cs" />
    <Compile Include="../../Core/PatchManifest.cs" Link="PatchManifest.cs" />
    <Compile Include="../../Core/AdaptivePatchScanner.cs" Link="AdaptivePatchScanner.cs" />
    <EmbeddedResource Include="../../Core/Assets/bitrate-patch.json" LogicalName="SteamFrame.Assets.bitrate-patch.json" />
    <EmbeddedResource Include="../../Core/Assets/bitrate-patch-stable.json" LogicalName="SteamFrame.Assets.bitrate-patch-stable.json" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
</Project>
