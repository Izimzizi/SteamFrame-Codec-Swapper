<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>SteamFrameTray</AssemblyName>
    <RootNamespace>SteamFrameTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <ProbeDll Condition="'$(ProbeDll)' == ''">$(MSBuildThisFileDirectory)../Native/build/SteamFrameEncoderProbe.dll</ProbeDll>
    <!-- The supervised codec runtime (runtime/, Assets/, scripts, Backend/); assembled by Package-Tray.ps1. -->
    <CodecLabSource Condition="'$(CodecLabSource)' == ''">$(MSBuildThisFileDirectory)../artifacts/CodecLab</CodecLabSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared UI-free code: SteamVR/Frame access, codec control, patching, health and the kept advanced tools. -->
    <Compile Include="../Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Core/Assets/bitrate-patch.json" LogicalName="SteamFrame.Assets.bitrate-patch.json" />
    <EmbeddedResource Include="../Core/Assets/bitrate-patch-stable.json" LogicalName="SteamFrame.Assets.bitrate-patch-stable.json" />
    <Content Include="$(ProbeDll)" Link="Native/SteamFrameEncoderProbe.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(ProbeDll)')" />
    <Content Include="$(CodecLabSource)/**" Link="CodecLab/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(CodecLabSource)')" />
  </ItemGroup>
  <Target Name="WarnMissingCodecLab" BeforeTargets="Build" Condition="!Exists('$(CodecLabSource)')">
    <Warning Text="CodecLab was not found at $(CodecLabSource). Run Package-Tray.ps1, or copy a CodecLab folder beside SteamFrameTray.exe." />
  </Target>
</Project>
