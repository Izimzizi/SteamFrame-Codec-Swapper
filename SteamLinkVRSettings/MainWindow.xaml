<Window
    x:Class="SteamLinkVRSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SteamFrame Advanced Options">

    <Grid Background="{StaticResource SteamDarkBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0"
                       Text="SteamFrame Advanced Options"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="228" ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="600" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource SteamBlue}" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" Icon="Home"/>
                <NavigationViewItem Content="Stream settings" Tag="stream" Icon="Play"/>
                <NavigationViewItem Content="Auto tune" Tag="benchmark" Icon="Find"/>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="ShowResults"/>
                <NavigationViewItem Content="Connection" Tag="connection" Icon="Link"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Advanced" Tag="advanced" Icon="Setting"/>
                <NavigationViewItem Content="Patches &amp; Recovery" Tag="tools" Icon="Repair"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Additional settings" Tag="settings" Icon="List"/>
                <NavigationViewItem Content="Back to stock" Tag="stock" Icon="Undo"/>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
