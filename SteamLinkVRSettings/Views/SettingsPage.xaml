<Page x:Class="SteamLinkVRSettings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI Variable Text" Background="{StaticResource SteamDarkBgBrush}" Loaded="Page_Loaded">
    <Grid Padding="24,18,24,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="Additional settings" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"/><TextBlock Text="Less common driver options. Stream settings and Advanced contain the guided controls." TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" MaxWidth="700" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock x:Name="HmdInfoText" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="GpuInfoText" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBox x:Name="SettingSearch" PlaceholderText="Search by name, setting key or description" TextChanged="SettingSearch_TextChanged"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveButton" Content="Apply changes" Style="{StaticResource SteamActionButtonStyle}" Click="SaveButton_Click" IsEnabled="False"/><Button x:Name="ResetAllButton" Content="Reset additional settings" Click="ResetAllButton_Click"/><Button x:Name="ReloadButton" Content="Reload" Click="ReloadButton_Click"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="6"><InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/><InfoBar x:Name="UnsavedBar" IsOpen="False" IsClosable="False" Severity="Informational"><InfoBar.Content><TextBlock x:Name="UnsavedText" Foreground="{StaticResource TextFillColorSecondaryBrush}"/></InfoBar.Content></InfoBar></StackPanel>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="8" Padding="0,0,8,16"><TextBlock x:Name="SearchEmpty" Text="No additional settings match. Common options have their own home in Stream settings or Advanced." Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}"/><StackPanel x:Name="SettingsPanel" Spacing="8"/></StackPanel></ScrollViewer>
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="4" Background="{StaticResource SteamDarkBgBrush}" Visibility="Visible"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><ProgressRing IsActive="True" Width="32" Height="32"/><TextBlock Text="Loading settings…"/></StackPanel></Grid>
    </Grid>
</Page>
