<Page
    x:Class="SteamLinkVRSettings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SteamDarkBgBrush}"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="36,20,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Steam Link VR Settings"
                               Style="{StaticResource TitleTextBlockStyle}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="HmdInfoText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="GpuInfoText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}"
                            Click="SaveButton_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetAllButton" Click="ResetAllButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                            <TextBlock Text="Reset All" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Click="ReloadButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Reload" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <InfoBar x:Name="StatusBar" Grid.Row="1"
                     IsOpen="False" IsClosable="True"
                     Margin="0,8,0,0" />

            <!-- Unsaved changes bar -->
            <InfoBar x:Name="UnsavedBar" Grid.Row="2"
                     IsOpen="False" IsClosable="False"
                     Severity="Warning"
                     Margin="0,4,0,0">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,0,0,4">
                        <TextBlock x:Name="UnsavedText" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </Grid>

        <!-- Scrollable settings -->
        <ScrollViewer Grid.Row="1" Padding="36,12,36,24"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel" Spacing="8" />
        </ScrollViewer>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2"
              Background="#80000000" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Loading settings..." HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
