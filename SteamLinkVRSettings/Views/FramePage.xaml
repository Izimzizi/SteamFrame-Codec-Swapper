<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:SteamLinkVRSettings.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource SteamDarkBgBrush}" FontFamily="Segoe UI Variable Text" Loaded="Page_Loaded" Unloaded="Page_Unloaded" x:Class="SteamLinkVRSettings.Views.FramePage">
    <Page.Resources>
        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollMode" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>
    <Grid Padding="24,18,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="12">
                <TextBlock Text="Overview" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" x:Name="SectionHeading" />
                <TextBlock Text="Your live stream, at a glance." Style="{StaticResource Hint}" x:Name="SectionDescription" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SteamCardBgBrush}" CornerRadius="4" Padding="10,6" VerticalAlignment="Top">
                <TextBlock x:Name="RuntimeText" Text="Checking SteamVR…" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0" FontSize="12" MaxWidth="140" TextWrapping="Wrap" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="EncoderRestartNotice" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="Finish the app update"
                     Message="SteamVR is still using an older encoder helper. Restarting briefly disconnects the headset and may close the running game. The app will resume monitoring and reapply saved tuning when enabled.">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartEncoderButton" Content="Restart SteamVR and resume" Click="StartMonitor_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="EncoderPolicyNotice" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="Requested encoder policy is not active" />
            <InfoBar x:Name="ActionStatus" IsOpen="False" IsClosable="True" />
        </StackPanel>
        <Grid Grid.Row="2">
            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" x:Name="BenchmarkView">
                <StackPanel Spacing="16" Padding="0,0,8,16">
                    <Border x:Name="BenchmarkProgressCard" Visibility="Collapsed" Background="{StaticResource SteamCardBgBrush}" BorderBrush="{StaticResource SteamBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="BenchmarkPhaseTitle" Text="Preparing" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BenchmarkPhaseCount" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="BenchmarkPercent" Text="0%" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource SteamBlueBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BenchmarkPercentCaption" Text="estimated" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="BenchmarkProgress" Minimum="0" Maximum="100" Value="0" Height="8" AutomationProperties.Name="Estimated overall benchmark completion"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="BenchmarkPrepareStep" Text="1  Prepare" Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="BenchmarkCompareStep" Grid.Column="1" Text="2  Compare modes" Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="BenchmarkTuneStep" Grid.Column="2" Text="3  Tune choices" Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="BenchmarkRestoreStep" Grid.Column="3" Text="4  Restore" Style="{StaticResource Hint}"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource SteamBorderBrush}" Margin="0,2"/>
                            <TextBlock x:Name="BenchmarkCurrentCandidate" FontSize="14" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="BenchmarkMeasurementLabel" Text="Preparing current test" Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="BenchmarkMeasurementTime" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar x:Name="BenchmarkTrialProgress" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource SteamBlueBrush}" AutomationProperties.Name="Current test measurement progress"/>
                            <TextBlock x:Name="BenchmarkStatus" Text="Checking the headset and current settings…" TextWrapping="Wrap"/>
                            <TextBlock x:Name="BenchmarkCompletedCount" Style="{StaticResource Hint}"/>
                            <TextBlock Text="Overall progress is an estimate. Optional tests may be skipped; reconnecting and restoring settings also take time." Style="{StaticResource Hint}"/>
                            <Button x:Name="BenchmarkCancelButton" Content="Stop and restore" IsEnabled="False" Click="BenchmarkCancel_Click" />
                            <HyperlinkButton x:Name="BenchmarkResultsLink" Content="View recommendations" Visibility="Collapsed" Click="BenchmarkResults_Click" Padding="0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SteamCardBgBrush}" CornerRadius="6" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Presets built around your connection" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Compare balanced, higher-detail and higher-refresh setups using a moving test room. Auto tune checks resolution, Hz, encoder passes, gaze quality and bitrate." Style="{StaticResource Hint}" />
                            <TextBlock Text="Smoothness measures delivery hitches, not end-to-end latency. A larger stream can maintain steady FPS while arriving later. Auto tune does not measure visual quality or motion-to-photon delay." Style="{StaticResource Hint}" />
                            <TextBlock Text="Close your VR game and connect using HEVC. Leave the Frame on a desk with its tracking cameras uncovered. Requires NVIDIA NVENC and paired wireless SSH." Style="{StaticResource Hint}" />
                            <TextBlock Text="Allow about 15–25 minutes. The app keeps the Frame awake, may restart SteamVR, and restores your starting settings and Hz afterward. You can stop and restore at any time." Style="{StaticResource Hint}" />
                            <Button x:Name="BenchmarkStartButton" Content="Start auto tune" Style="{StaticResource SteamActionButtonStyle}" Click="BenchmarkStart_Click" />
                            <HyperlinkButton Content="Set up headset monitoring" Tag="connection" Click="OpenSection_Click" Padding="0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Expander Header="Test limits and comparisons" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" x:Name="BenchmarkOptionsPanel" Padding="0,12,0,0">
                        <CheckBox x:Name="BenchmarkUnattended" Content="Run without wearing the Frame (temporary keep-awake)" IsChecked="True" />
                        <controls:NoWheelNumberBox x:Name="BenchmarkMaximum" Header="Maximum target to try (Mbps)" Minimum="100" Maximum="500" Value="450" SmallChange="25" SpinButtonPlacementMode="Compact" />
                        <TextBlock Text="The installed driver ceiling also applies. The benchmark does not install a driver patch." Style="{StaticResource Hint}" />
                        <CheckBox x:Name="BenchmarkResolutions" Content="Compare 1280, 1664 and 2048-pixel stream widths, plus my current width" IsChecked="True" />
                        <CheckBox x:Name="BenchmarkRefreshRates" Content="Compare 90 and 120 Hz (changes headset and PC display mode)" IsChecked="True" />
                        <controls:NoWheelNumberBox x:Name="BenchmarkTrialSeconds" Header="Seconds per screening trial" Minimum="8" Maximum="60" Value="10" SmallChange="2" SpinButtonPlacementMode="Compact" />
                        <controls:NoWheelNumberBox x:Name="BenchmarkValidationSeconds" Header="Seconds per final confirmation" Minimum="20" Maximum="300" Value="35" SmallChange="5" SpinButtonPlacementMode="Compact" />
                        <controls:NoWheelNumberBox x:Name="BenchmarkHeadroom" Header="Bitrate headroom (%)" Minimum="5" Maximum="25" Value="10" SmallChange="5" SpinButtonPlacementMode="Compact" />
                        <CheckBox x:Name="BenchmarkFullMultipass" Content="Include full-resolution multipass alongside single and quarter pass" IsChecked="True" />
                        <controls:NoWheelNumberBox x:Name="BenchmarkIssuePercent" Header="Serious-issue threshold: estimated affected frames (%)" Minimum="1" Maximum="15" Value="5" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <controls:NoWheelNumberBox x:Name="BenchmarkIssueMilliseconds" Header="Serious-issue threshold: frame-equivalent hitch load (ms)" Minimum="100" Maximum="2000" Value="500" SmallChange="100" SpinButtonPlacementMode="Compact" />
                        <CheckBox x:Name="BenchmarkReduceQuality" Content="Compare gaze and periphery independently, including 0 / 0" IsChecked="True" />
                        <TextBlock Text="On shortlisted modes: test gaze +6, 0, −6, −12, −20 with periphery 0; test periphery +8, 0, −4, −8, −12 with gaze 0. Also test your starting offsets and combinations of useful values. Negative offsets request more detail; positive offsets reduce detail. 0 / 0 keeps Valve's foveation. Turning this comparison off keeps your current offsets." Style="{StaticResource Hint}" />
                        <TextBlock Text="Ranking favors detail below the serious-issue threshold, balanced with smoothness and Hz. Higher Mbps alone earns no extra score. Whole-frame QP helps compare bitrate changes at identical settings; it is not a visual quality measurement. Turning off resolution or Hz comparison keeps your current value." Style="{StaticResource Hint}" />
                        <TextBlock Text="The active sender mode stays fixed. To compare another mode, change Asynchronous sending in Advanced, reconnect, then run auto tune again." Style="{StaticResource Hint}" />
                    </StackPanel>
                    </Expander>
                    <TextBlock Text="Default: 10-second screens, 35-second confirmations and 10% bitrate headroom. You choose which resulting preset to apply. Options without usable measurements are labeled unmeasured." Style="{StaticResource Hint}" />
                    <Border x:Name="BenchmarkResultCard" Visibility="Collapsed" Background="{StaticResource SteamCardBgBrush}" CornerRadius="6" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="BenchmarkResultTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="BenchmarkResultDetail" TextWrapping="Wrap" />
                            <TextBlock Text="Stream width is the encoder's packed-image width, not a per-eye display resolution. Hitch percentages are estimates; a high smoothness score does not establish low latency. Short comparisons identify useful options; test your choice in games. Warnings remain visible even for the best available option." Style="{StaticResource Hint}" />
                            <StackPanel x:Name="BenchmarkChoiceList" Spacing="12" />
                        </StackPanel>
                    </Border>
                    <Expander x:Name="BenchmarkTrialsExpander" Header="Trial results" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="BenchmarkTrials" Text="Completed trials will appear here." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Expander>
                    <Button x:Name="BenchmarkReportButton" Content="Open benchmark reports" Click="BenchmarkReports_Click" HorizontalAlignment="Left" />
                    <Button x:Name="BenchmarkRecoverButton" Content="Restore starting settings from an interrupted test" Click="BenchmarkRecover_Click" HorizontalAlignment="Left" />
                    <TextBlock Text="Recovery preserves newer settings changed by you or another controller. If the Frame disconnected, reconnect it first. Missing or reset measurements never count as a passing test." Style="{StaticResource Hint}" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="Visible" VerticalScrollBarVisibility="Auto" x:Name="OverviewView">
                <StackPanel Spacing="12" Padding="0,0,8,16" HorizontalAlignment="Stretch">
                    <Border Background="{StaticResource SteamCardBgBrush}" CornerRadius="6" Padding="16">
                        <Grid ColumnSpacing="32" x:Name="OverviewMetrics" SizeChanged="OverviewMetrics_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" x:Name="VideoMetric">
                                <TextBlock Text="Encoded video" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="VideoRate" Text="—" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource SteamBlueBrush}" />
                                    <TextBlock Text="Mbps" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                </StackPanel>
                                <TextBlock x:Name="VideoDetail" Text="Start the live monitor during a stream." Style="{StaticResource Hint}" />
                                <TextBlock x:Name="CodecReadback" Text="Codec: Unknown" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" Margin="0,5,0,0" x:Name="TargetMetric">
                                <TextBlock Text="Requested target" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="TargetReadback" Text="— Mbps" FontSize="24" TextWrapping="Wrap" />
                                <TextBlock x:Name="TargetMode" Text="" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8" Margin="0,5,0,0" x:Name="PathMetric">
                                <TextBlock Text="Video path" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="WiredReadback" Text="Unknown" FontSize="24" MaxWidth="210" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <TextBlock x:Name="WifiReadback" Text="Wi-Fi: unknown" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="DongleUsbReadback" Text="Dongle USB: checking…" Style="{StaticResource Hint}" MaxWidth="210" />
                            </StackPanel>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </Border>
                    <controls:ActionPanel>
                        <Button x:Name="MonitorButton" Content="Start monitoring" Style="{StaticResource SteamActionButtonStyle}" Click="StartMonitor_Click" />
                        <Button x:Name="StopMonitorButton" Content="Stop monitoring" Click="StopMonitor_Click" />
                    </controls:ActionPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Last 60 seconds" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="GraphScale" Text="0–500 Mbps" HorizontalAlignment="Right" Style="{StaticResource Hint}" Grid.Column="1" />
                    </Grid>
                    <Canvas x:Name="RateGraph" Height="175" SizeChanged="Graph_SizeChanged" />
                    <TextBlock Text="Blue: encoded video   Green: connection traffic   Dashed: driver-reported rate when fresh, otherwise requested target" Style="{StaticResource Hint}" />
                    <Border Background="{StaticResource SteamCardBgBrush}" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Wireless link" FontSize="15" />
                            <TextBlock x:Name="LinkStateReadback" Text="Video link: no change seen since this app opened" TextWrapping="Wrap" />
                            <TextBlock x:Name="LinkEstimateReadback" Text="SteamVR link estimate: waiting for a stream" TextWrapping="Wrap" />
                            <TextBlock x:Name="HeldFramesReadback" Text="Held frames: none recorded yet" TextWrapping="Wrap" />
                            <TextBlock x:Name="RadioReadback" Text="Radio: checking…" TextWrapping="Wrap" />
                            <Border Height="1" Background="{StaticResource SteamBorderBrush}" />
                            <TextBlock x:Name="AdviceHeadline" Text="No recommendation yet." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="900" />
                            <TextBlock x:Name="AdviceReasons" Text="" Style="{StaticResource Hint}" MaxWidth="900" />
                            <controls:ActionPanel>
                                <Button x:Name="ApplyCeilingButton" Content="Apply measured ceiling" Style="{StaticResource SteamActionButtonStyle}" Click="ApplyCeiling_Click" Visibility="Collapsed" />
                                <Button x:Name="AutoStartButton" Content="Automatic from measured" Click="AutomaticStart_Click" Visibility="Collapsed" ToolTipService.ToolTip="Turns automatic bitrate on with SteamVR starting at the highest clean ceiling the last week's sweeps measured, so it starts high and backs off when the link dips." />
                                <Button x:Name="UseAdviceButton" Content="Use recommended target" Click="UseAdvice_Click" IsEnabled="False" />
                            </controls:ActionPanel>
                            <controls:ActionPanel>
                                <Button x:Name="SweepButton" Content="Find my link's limit" Click="Sweep_Click" IsEnabled="False" />
                                <Button x:Name="QuickCheckButton" Content="Check this rate (30 s)" Click="QuickCheck_Click" IsEnabled="False" ToolTipService.ToolTip="Measures the current target once, about 30 seconds, without changing or saving anything: is this rate still clean today?" />
                                <Button x:Name="SweepStopButton" Content="Stop sweep" Click="StopSweep_Click" Visibility="Collapsed" />
                                <Button x:Name="RestartStreamButton" Content="Restart Frame stream" Click="RestartFrameStream_Click" />
                            </controls:ActionPanel>
                            <TextBlock x:Name="SweepStatus" Text="Find my link’s limit tests bitrate steps, then restores your settings or applies a fully measured, confirmed result if you choose. Check this rate takes about 30 seconds. Auto tune compares complete picture-quality presets." Style="{StaticResource Hint}" MaxWidth="900" />
                            <Border x:Name="SweepResultsCard" Background="{StaticResource SteamDarkBgBrush}" CornerRadius="4" Padding="12" Visibility="Collapsed">
                                <TextBlock x:Name="SweepResults" Text="" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </Border>
                            <Expander Header="Radio, capacity and desk testing" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10" Padding="0,12,0,0">
                                    <TextBlock x:Name="CapacityReadback" Text="Link capacity: waiting for SteamVR's 30-second capacity histogram." Style="{StaticResource Hint}" MaxWidth="900" />
                                    <StackPanel x:Name="CapacityPanel" Spacing="4" Visibility="Collapsed">
                                        <Canvas x:Name="CapacityGraph" Height="44" SizeChanged="CapacityGraph_SizeChanged" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="0 Mbps" Style="{StaticResource Hint}" FontSize="11" />
                                            <TextBlock x:Name="CapacityAxisRight" Text="" Style="{StaticResource Hint}" FontSize="11" Grid.Column="1" />
                                        </Grid>
                                        <TextBlock Text="Blue: frames by measured link capacity (log scale)   Green: at or above the histogram's top bucket   Dashed: requested target" Style="{StaticResource Hint}" FontSize="11" MaxWidth="900" />
                                    </StackPanel>
                                    <TextBlock x:Name="RadioDetail" Text="" Style="{StaticResource Hint}" MaxWidth="900" />
                                    <ToggleSwitch x:Name="KeepFrameAwakeInput" Header="Keep Frame awake" OnContent="Renewing the headset's activity extension" OffContent="Headset idles normally when it is off your head" Toggled="KeepFrameAwake_Toggled" IsEnabled="False" />
                                    <TextBlock x:Name="KeepFrameAwakeHint" Text="Keeps the headset streaming while it is on a desk. Requires paired SSH and ends when switched off or the app closes. Link tests keep it awake automatically." Style="{StaticResource Hint}" MaxWidth="900" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="HealthCounts" Style="{StaticResource Hint}" />
                    <Button x:Name="ReconnectFrameButton" Content="Reconnect Frame" Click="ReconnectFrame_Click" />
                    <TextBlock Text="Restarts SteamVR once and restores applied HEVC tuning. A running VR game may close. Keep the Frame awake; the app checks for fresh video afterward." Style="{StaticResource Hint}" />
                    <TextBlock Text="Still disconnected? Unplug the dedicated dongle, plug it back in, and wait for it to reconnect. You can use the same port or hub. Then select this PC in the Frame's streaming menu if needed." Style="{StaticResource Hint}" />
                    <HyperlinkButton Content="View streaming diagnostics" Tag="diagnostics" Click="OpenSection_Click" HorizontalAlignment="Left" Padding="0" />
                    <Expander Header="Connection details" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock x:Name="LinkReadback" Text="Checking headset…" TextWrapping="Wrap" />
                            <TextBlock x:Name="LinkStatus" Text="" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="UsbTraffic" Text="Checking adapters…" TextWrapping="Wrap" />
                            <TextBlock x:Name="DongleUsbDetail" Text="Checking the dongle's USB connection…" Style="{StaticResource Hint}" />
                            <TextBlock Text="Connection traffic includes error correction and overhead, so it can be higher than video bitrate." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Grid Visibility="Collapsed" RowSpacing="10" x:Name="StreamView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,8,12" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:NoWheelComboBox PlaceholderText="Choose a complete preset" SelectionChanged="PresetSelection_Changed" HorizontalAlignment="Stretch" x:Name="PresetSelection" />
                            <Button Content="Save preset…" Click="SavePreset_Click" Grid.Column="1" />
                        </Grid>
                        <TextBlock Text="Presets load into the editor. Apply when you are ready." Style="{StaticResource Hint}" x:Name="PresetSummary" />
                        <HyperlinkButton x:Name="ReloadPresetButton" Content="Reload selected preset" Click="ReloadPreset_Click" HorizontalAlignment="Left" Padding="0" Visibility="Collapsed" />
                        <HyperlinkButton Content="Encoder, sending and driver options" Tag="advanced" Click="OpenSection_Click" HorizontalAlignment="Left" Padding="0" />
                        <TextBlock x:Name="CodecCurrentReadback" Text="Current encoder: checking…" TextWrapping="Wrap" Style="{StaticResource Hint}" />
                        <controls:NoWheelComboBox x:Name="CodecSelectionInput" Header="Video codec" SelectedIndex="0" SelectionChanged="CodecSelection_Changed" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="HEVC" />
                            <ComboBoxItem Content="AV1" />
                            <ComboBoxItem Content="H.264" />
                        </controls:NoWheelComboBox>
                        <Grid ColumnSpacing="16" RowSpacing="12" SizeChanged="StreamMainFields_SizeChanged" x:Name="StreamMainFields">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:NoWheelNumberBox x:Name="BitrateInput" Minimum="25" Maximum="500" SmallChange="5" LargeChange="25" Value="100" SpinButtonPlacementMode="Compact" Header="Video bitrate target (Mbps)" ValueChanged="Bandwidth_ValueChanged" />
                            <controls:NoWheelComboBox x:Name="CodecRefreshInput" Grid.Column="1" Header="Display refresh rate" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CodecRefresh_Changed">
                                <ComboBoxItem Content="90 Hz" />
                                <ComboBoxItem Content="120 Hz" />
                            </controls:NoWheelComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" x:Name="CodecModeHint" />
                        <TextBlock Style="{StaticResource Hint}" x:Name="RefreshReadback" Text="Active display Hz has not been verified." />
                        <TextBlock Style="{StaticResource Hint}" Text="Changing Hz also changes the Frame's display mode and requires paired headset SSH. SteamVR reconnects if needed, which may close the running game." />
                        <ToggleSwitch x:Name="AutomaticInput" Header="Automatic bitrate" OnContent="SteamVR adjusts the bitrate" OffContent="Use the target above" Toggled="Bandwidth_Toggled" />
                        <StackPanel Spacing="12" x:Name="AutomaticOptions">
                            <controls:NoWheelNumberBox x:Name="StartingBandwidthInput" Header="Automatic starting bandwidth (Mbps)" Minimum="25" Maximum="500" SmallChange="5" LargeChange="25" Value="200" SpinButtonPlacementMode="Compact" ValueChanged="Bandwidth_ValueChanged" />
                            <TextBlock Text="With automatic bitrate on, SteamVR starts from this rate and adjusts it from its own link measurements. Valve's default is 200 Mbps. The Overview shows the estimate SteamVR arrives at." Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Border Background="{StaticResource SteamCardBgBrush}" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Wireless advisor" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="StreamAdviceHeadline" Text="No recommendation yet." FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="StreamAdviceDetail" Text="The Overview card explains the advice once a stream is running." Style="{StaticResource Hint}" />
                                <Button x:Name="StreamUseAdviceButton" Content="Use recommended target" Click="UseAdvice_Click" IsEnabled="False" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="CodecSessionStatus" Text="Checking codec service…" Style="{StaticResource Hint}" />
                        <PasswordBox x:Name="CodecPasswordInput" Header="Frame user password" PlaceholderText="Enter privately to start a codec session" PasswordRevealMode="Hidden" Visibility="Collapsed" />
                        <TextBlock x:Name="CodecAuthenticationHint" Text="The password authenticates this codec session and is not saved. An existing live session needs no password to switch." Style="{StaticResource Hint}" Visibility="Collapsed" />
                        <Border Height="1" Background="{StaticResource SteamBorderBrush}" />
                        <TextBlock Text="Picture quality" FontSize="18" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="SupersampleFilteringInput" Header="Advanced Supersample Filtering" OnContent="Enabled" OffContent="Disabled" Toggled="SupersampleFiltering_Toggled" />
                        <TextBlock x:Name="SupersampleFilteringReadback" Text="Checking SteamVR video setting…" Style="{StaticResource Hint}" />
                        <TextBlock Text="Use Apply below to activate this setup, including filtering." Style="{StaticResource Hint}" />
                        <StackPanel Spacing="12" x:Name="HevcPictureOptions">
                            <controls:NoWheelNumberBox x:Name="StreamWidthInput" Header="Stream width (pixels)" Minimum="512" Maximum="4096" SmallChange="128" LargeChange="256" Value="1536" SpinButtonPlacementMode="Compact" ValueChanged="Bandwidth_ValueChanged" />
                            <TextBlock Text="Larger widths preserve more spatial detail but add encoding and decoding work, even at the same bitrate and FPS. This is packed stream width, not per-eye resolution. To keep HQ's width while reducing latency, try the Lower-latency HEVC preset; it uses more compression." Style="{StaticResource Hint}" />
                            <ToggleSwitch x:Name="AutomaticWidthInput" Header="Automatic image width" OnContent="Valve chooses the width" OffContent="Request the width above" Toggled="Bandwidth_Toggled" />
                            <ToggleSwitch x:Name="QualityInput" Header="Custom gaze quality" OnContent="Apply the offsets below" OffContent="Keep Valve's quality map" Toggled="Bandwidth_Toggled" />
                            <Grid ColumnSpacing="16" RowSpacing="12" SizeChanged="GazeFields_SizeChanged" x:Name="GazeFields">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:NoWheelNumberBox x:Name="GazeInput" Header="Center quality offset" Minimum="-20" Maximum="12" SmallChange="1" Value="-4" SpinButtonPlacementMode="Compact" ValueChanged="Bandwidth_ValueChanged" />
                                <controls:NoWheelNumberBox x:Name="PeripheralInput" Grid.Column="1" Header="Outside-gaze quality offset" Minimum="-12" Maximum="31" SmallChange="1" Value="8" SpinButtonPlacementMode="Compact" ValueChanged="Bandwidth_ValueChanged" />
                            </Grid>
                            <TextBlock Text="Negative offsets improve detail. Positive offsets reduce detail; outside-gaze values above +12 are aggressive. These change compression quality, not the physical size of the tracked gaze region." Style="{StaticResource Hint}" />
                            <StackPanel Spacing="12" Orientation="Horizontal">
                                <Button Content="Quality focus" Click="QualityPreset_Click" />
                                <Button Content="Valve gaze defaults" Click="QualityDefault_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Expander Header="More stream options" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12" Padding="0,12,0,0">
                                <ToggleSwitch x:Name="AmfInput" Header="Allow AMD encoder" OnContent="Available on compatible AMD hardware" OffContent="AMF disabled" Toggled="Bandwidth_Toggled" />
                                <ToggleSwitch x:Name="MultipleLinksInput" Header="Allow additional video connections" OnContent="Valve may use available links together" OffContent="Use the first link only" IsOn="False" Toggled="Bandwidth_Toggled" />
                                <TextBlock Text="Keep headset Wi-Fi enabled for discovery. The dongle carries video on its dedicated link. Additional links do not guarantee more bandwidth." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="{StaticResource SteamBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Review the controls, then apply." Style="{StaticResource Hint}" VerticalAlignment="Center" x:Name="StreamChangeStatus" />
                        <StackPanel Spacing="12" Orientation="Horizontal" Grid.Column="1">
                            <ProgressRing x:Name="CodecSwitchProgress" IsActive="False" Width="24" Height="24" />
                            <Button x:Name="ApplyButton" Content="Apply stream settings" Style="{StaticResource SteamActionButtonStyle}" Click="Apply_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" x:Name="DiagnosticsView">
                <StackPanel Spacing="12" Padding="0,0,8,16" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Streaming report" FontSize="18" FontWeight="SemiBold" />
                        <Button Content="Open report folder" Click="OpenCaptureFolder_Click" Grid.Column="1" />
                    </Grid>
                    <TextBlock x:Name="HealthSummary" Text="Watching for new streaming issues…" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiagnosticUsbStatus" Text="Dongle USB: checking…" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReceiverStatus" Text="Checking the Frame receiver over wireless…" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="ReceiverCounts" TextWrapping="Wrap" />
                    <Border Background="{StaticResource SteamCardBgBrush}" CornerRadius="4" Padding="14">
                        <TextBlock x:Name="HealthEvents" Text="New recovery requests, network delays and encoder stalls appear here." IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="Retries can repeat packets. PC presentation drops and receiver errors are separate; neither is a complete headset drop count." Style="{StaticResource Hint}" />
                    <Expander Header="PC frame timing" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock x:Name="CompositorStatus" Text="Checking PC presentation timing…" TextWrapping="Wrap" />
                            <TextBlock x:Name="CompositorDetail" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="HealthTrace" Text="Per-frame timing appears when SteamVR saves a recovery trace." IsTextSelectionEnabled="True" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Encoder details" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock x:Name="CodecDetail" Text="Waiting for verified encoder output." Style="{StaticResource Hint}" />
                            <TextBlock x:Name="ProbeStatus" Text="The monitor measures compressed NVENC frames before network overhead and checks encoder compatibility automatically." Style="{StaticResource Hint}" />
                            <TextBlock x:Name="QualityReadback" Text="Foveation: Valve defaults" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="PolicyRequestedReadback" Text="Requested policy: Valve defaults" TextWrapping="Wrap" />
                            <TextBlock x:Name="PolicyAppliedReadback" Text="Accepted NVENC configuration: waiting for a verified initialize/reconfigure call" TextWrapping="Wrap" />
                            <TextBlock x:Name="QuantizerReadback" Text="Whole-frame QP: unavailable" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="CenterMapReadback" Text="Gaze map deltas: unavailable" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="AdvancedLiveReadback" Text="Advanced encoder configuration: updated helper required" TextWrapping="Wrap" />
                            <TextBlock x:Name="CallbackTimingReadback" Text="Encoder API duration: unavailable" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Unattended testing" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <ToggleSwitch x:Name="KeepAwakeInput" Header="Keep SteamVR awake" OnContent="Temporary one-hour screen timeout; compositor keeps running" OffContent="Original power settings" Toggled="KeepAwake_Toggled" />
                            <TextBlock Text="Original power settings are restored when disabled or when this app closes." Style="{StaticResource Hint}" />
                            <TextBlock x:Name="PowerLeaseStatus" Text="No temporary power lease" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" x:Name="AdvancedView">
                <StackPanel Spacing="12" Padding="0,0,8,16" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="AdvancedCapabilityStatus" Text="Checking the native helper…" TextWrapping="Wrap" />
                    <Expander Header="Encoding method" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <controls:NoWheelComboBox x:Name="RateControlInput" Header="Rate control" SelectedIndex="0" SelectionChanged="Policy_SelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Valve default" />
                                <ComboBoxItem Content="VBR" />
                                <ComboBoxItem Content="CBR without filler or padding" />
                            </controls:NoWheelComboBox>
                            <controls:NoWheelComboBox x:Name="MultiPassInput" Header="Encoding passes" SelectedIndex="0" SelectionChanged="Policy_SelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Valve default" />
                                <ComboBoxItem Content="Single pass" />
                                <ComboBoxItem Content="Quarter-resolution multipass" />
                                <ComboBoxItem Content="Full-resolution multipass (experimental)" />
                            </controls:NoWheelComboBox>
                            <TextBlock Text="Single pass uses less encoding work. Quarter-resolution multipass analyzes a smaller image first, then encodes at full resolution. Full-resolution multipass analyzes and encodes at full resolution; compare detail and frame timing before keeping it." Style="{StaticResource Hint}" />
                            <TextBlock Text="Single pass reduces analysis work. Quarter-resolution multipass added about 1 ms at 2048 pixels in our comparison; stream width and bitrate had larger effects. Results vary by setup. Multipass does not change final image resolution or decoder count." Style="{StaticResource Hint}" />
                            <TextBlock Text="CBR here does not add padding or lock Valve's adaptive encoder target. Actual Mbps can still vary. Switching between VBR and CBR may need a new encoder session; check the accepted mode after reconnecting." Style="{StaticResource Hint}" />
                            <CheckBox x:Name="ReapplyInput" Content="Reapply my HEVC encoder and gaze settings after SteamVR restarts" Checked="Bandwidth_Toggled" Unchecked="Bandwidth_Toggled" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Encoder quality and buffering" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock Text="Enable Override only for values you want to change. Preset, chroma, adaptive quantization, GOP consistency and keyframe-ratio changes need a new encoder session." Style="{StaticResource Hint}" />
                            <StackPanel x:Name="AdvancedEncoderHost" Spacing="16" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Driver and network settings" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock Text="10-bit encoding, asynchronous sending, sharpening, QoS, retries and resolution bounds. Check Override to set a value; clear it to use Valve's default." Style="{StaticResource Hint}" />
                            <StackPanel x:Name="AdvancedDriverHost" Spacing="16" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Spacing="12" Orientation="Horizontal">
                        <Button x:Name="AdvancedApplyButton" Content="Apply advanced settings" Style="{StaticResource SteamActionButtonStyle}" Click="ApplyAdvanced_Click" />
                        <Button x:Name="AdvancedRestoreButton" Content="Reset advanced settings" Click="RestoreAdvanced_Click" />
                    </StackPanel>
                    <Expander Header="Accepted configuration" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock x:Name="AdvancedRequestedReadback" Text="Requested advanced encoding: Valve defaults" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <TextBlock x:Name="AdvancedAcceptedReadback" Text="Last successfully submitted configuration: not yet observed" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" x:Name="ConnectionView">
                <StackPanel Spacing="12" Padding="0,0,8,16" HorizontalAlignment="Stretch">
                    <TextBlock Text="Pair once. Use the dongle for streaming." FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionUsbStatus" Text="Checking the dongle's USB connection…" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConnectionRadioStatus" Text="Checking the dongle's radio association…" TextWrapping="Wrap" />
                    <TextBlock Text="Enable Developer Mode and pair this PC with SteamOS Devkit. Keep the Frame awake and its Wi-Fi enabled." Style="{StaticResource Hint}" />
                    <HyperlinkButton Content="Open the pairing guide" NavigateUri="https://github.com/elliotttate/SteamFrame-Advanced-Options/blob/main/docs/connection-setup.md" HorizontalAlignment="Left" Padding="0" />
                    <TextBox x:Name="SshHostInput" Header="Frame address" PlaceholderText="10.35.78.1 for the dedicated dongle" />
                    <Button Content="Use dongle address" Click="UseDongleAddress_Click" HorizontalAlignment="Left" />
                    <Expander Header="Trusted SSH files" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBox x:Name="SshKeyInput" Header="SteamOS Devkit private-key file" />
                            <TextBox x:Name="SshKnownHostsInput" Header="Known-hosts file" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Optional ADB connection" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBox x:Name="AdbPathInput" Header="ADB executable" PlaceholderText="Path to platform-tools\adb.exe" />
                            <TextBox x:Name="SerialInput" Header="Frame ADB serial (optional when one device is connected)" />
                        </StackPanel>
                    </Expander>
                    <Button Content="Save and test connection" Click="SaveConnection_Click" HorizontalAlignment="Left" Style="{StaticResource SteamActionButtonStyle}" />
                    <TextBlock Text="Save your pairing details to test the connection." Style="{StaticResource Hint}" x:Name="ConnectionTestStatus" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" x:Name="ToolsView">
                <StackPanel Spacing="12" Padding="0,0,8,16" HorizontalAlignment="Stretch">
                    <TextBlock Text="HEVC bitrate override" FontSize="18" FontWeight="SemiBold" />
                    <Button Content="Walk me through bitrate setup" Click="BitrateSetup_Click" HorizontalAlignment="Left" />
                    <TextBlock Text="Status below is verified from the selected driver file, not a preset. Applying a preset can install its required override. SteamVR updates may replace it." Style="{StaticResource Hint}" />
                    <TextBlock Text="AV1 and H.264 apply their codec patches automatically from Stream settings. The override below raises HEVC's bitrate ceiling." Style="{StaticResource Hint}" />
                    <TextBlock Text="Allows compatible drivers to accept targets up to 500 Mbps. Actual bitrate depends on the scene and connection. Close SteamVR before changing the patch." Style="{StaticResource Hint}" />
                    <TextBlock x:Name="PatchVersion" TextWrapping="Wrap" />
                    <TextBlock x:Name="PatchStatus" Text="Checking installed driver…" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock x:Name="PatchCompatibility" Style="{StaticResource Hint}" />
                    <StackPanel Spacing="12" Orientation="Horizontal">
                        <Button x:Name="PatchButton" Content="Install 500 Mbps override" Style="{StaticResource SteamActionButtonStyle}" Click="InstallPatch_Click" />
                        <Button x:Name="RestoreButton" Content="Restore original driver" Click="RestorePatch_Click" />
                    </StackPanel>
                    <Expander Header="Driver file and verification" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBox x:Name="DriverPathInput" Header="SteamVR driver file" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Check driver" Click="InspectPatch_Click" />
                                <Button Content="Copy driver details" Click="CopyPatchDetails_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PatchDetails" Text="" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="USB recovery" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock Text="For the experimental USB setup with the previously installed daemon fix. Wireless streaming uses the dongle instead." Style="{StaticResource Hint}" />
                            <Button x:Name="RecoverButton" Content="Restart Frame USB connection" Click="RecoverUsb_Click" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" x:Name="StockView">
                <StackPanel Spacing="12" Padding="0,0,8,16" HorizontalAlignment="Stretch">
                    <TextBlock Text="A clean starting point" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Restore Valve streaming defaults, use HEVC, and remove custom gaze and encoder overrides. A verified bitrate patch is restored to the original driver too." Style="{StaticResource Hint}" />
                    <Border Background="{StaticResource SteamCardBgBrush}" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Checking current tuning…" TextWrapping="Wrap" x:Name="StockStatus" />
                            <TextBlock Text="Your current tuning is saved first. Pairing details and unrelated SteamVR settings are kept." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Restoring closes SteamVR and may close a running game. Reconnect the Frame after SteamVR restarts." Style="{StaticResource Hint}" />
                    <Button Content="Restore stock and restart SteamVR" Click="RestoreStock_Click" HorizontalAlignment="Left" x:Name="StockRestoreButton" Style="{StaticResource SteamActionButtonStyle}" />
                    <Border Height="1" Background="{StaticResource SteamBorderBrush}" />
                    <TextBlock Text="Return to your tuning" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="No previous tuning profile saved yet." Style="{StaticResource Hint}" x:Name="StockSnapshotStatus" />
                    <Button Content="Load previous tuning" Click="LoadPreviousProfile_Click" IsEnabled="False" HorizontalAlignment="Left" x:Name="PreviousProfileButton" />
                    <TextBlock Text="Loads the saved profile into the editor. Review it, then apply. Experimental codecs may need your Frame password again." Style="{StaticResource Hint}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
