<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Steam-inspired dark accent colors -->
    <Color x:Key="SteamBlue">#66C0F4</Color>
    <Color x:Key="SteamDarkBg">#142232</Color>
    <Color x:Key="SteamCardBg">#1C2D3F</Color>
    <Color x:Key="SteamCardHover">#243C52</Color>
    <Color x:Key="SteamBorderColor">#334A61</Color>
    <Color x:Key="SteamAccentGreen">#81C6A3</Color>
    <Color x:Key="SteamModified">#FFB347</Color>
    <Color x:Key="SystemAccentColor">#66C0F4</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F4F7FA"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#ADBCCD"/>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#66C0F4"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#66C0F4"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#66C0F4"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#102236"/>

    <SolidColorBrush x:Key="SteamBlueBrush" Color="{StaticResource SteamBlue}" />
    <SolidColorBrush x:Key="SteamDarkBgBrush" Color="{StaticResource SteamDarkBg}" />
    <SolidColorBrush x:Key="SteamCardBgBrush" Color="{StaticResource SteamCardBg}" />
    <SolidColorBrush x:Key="SteamCardHoverBrush" Color="{StaticResource SteamCardHover}" />
    <SolidColorBrush x:Key="SteamBorderBrush" Color="{StaticResource SteamBorderColor}" />
    <SolidColorBrush x:Key="SteamAccentGreenBrush" Color="{StaticResource SteamAccentGreen}" />
    <SolidColorBrush x:Key="SteamModifiedBrush" Color="{StaticResource SteamModified}" />

    <!-- Override window/page background -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource SteamDarkBg}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource SteamDarkBg}" />
    <Style x:Key="SteamActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SteamBlueBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SteamDarkBgBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</ResourceDictionary>
